BOT_NAME=AI-Bot
BOT_VERSION=1.0.0
LOG_LEVEL=INFO

# GitHub integration
GITHUB_REPO=vinit-cyber-lab/AI-Bot
GITHUB_TOKEN=

# Discord webhook notification
DISCORD_WEBHOOK_URL=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local scheduler settings
GITHUB_CHECK_INTERVAL_MINUTES=5
HEALTH_CHECK_INTERVAL_MINUTES=10
BACKUP_INTERVAL_HOURS=1
DAILY_SUMMARY_TIME=09:00

# Optional settings
APP_ENV=development
