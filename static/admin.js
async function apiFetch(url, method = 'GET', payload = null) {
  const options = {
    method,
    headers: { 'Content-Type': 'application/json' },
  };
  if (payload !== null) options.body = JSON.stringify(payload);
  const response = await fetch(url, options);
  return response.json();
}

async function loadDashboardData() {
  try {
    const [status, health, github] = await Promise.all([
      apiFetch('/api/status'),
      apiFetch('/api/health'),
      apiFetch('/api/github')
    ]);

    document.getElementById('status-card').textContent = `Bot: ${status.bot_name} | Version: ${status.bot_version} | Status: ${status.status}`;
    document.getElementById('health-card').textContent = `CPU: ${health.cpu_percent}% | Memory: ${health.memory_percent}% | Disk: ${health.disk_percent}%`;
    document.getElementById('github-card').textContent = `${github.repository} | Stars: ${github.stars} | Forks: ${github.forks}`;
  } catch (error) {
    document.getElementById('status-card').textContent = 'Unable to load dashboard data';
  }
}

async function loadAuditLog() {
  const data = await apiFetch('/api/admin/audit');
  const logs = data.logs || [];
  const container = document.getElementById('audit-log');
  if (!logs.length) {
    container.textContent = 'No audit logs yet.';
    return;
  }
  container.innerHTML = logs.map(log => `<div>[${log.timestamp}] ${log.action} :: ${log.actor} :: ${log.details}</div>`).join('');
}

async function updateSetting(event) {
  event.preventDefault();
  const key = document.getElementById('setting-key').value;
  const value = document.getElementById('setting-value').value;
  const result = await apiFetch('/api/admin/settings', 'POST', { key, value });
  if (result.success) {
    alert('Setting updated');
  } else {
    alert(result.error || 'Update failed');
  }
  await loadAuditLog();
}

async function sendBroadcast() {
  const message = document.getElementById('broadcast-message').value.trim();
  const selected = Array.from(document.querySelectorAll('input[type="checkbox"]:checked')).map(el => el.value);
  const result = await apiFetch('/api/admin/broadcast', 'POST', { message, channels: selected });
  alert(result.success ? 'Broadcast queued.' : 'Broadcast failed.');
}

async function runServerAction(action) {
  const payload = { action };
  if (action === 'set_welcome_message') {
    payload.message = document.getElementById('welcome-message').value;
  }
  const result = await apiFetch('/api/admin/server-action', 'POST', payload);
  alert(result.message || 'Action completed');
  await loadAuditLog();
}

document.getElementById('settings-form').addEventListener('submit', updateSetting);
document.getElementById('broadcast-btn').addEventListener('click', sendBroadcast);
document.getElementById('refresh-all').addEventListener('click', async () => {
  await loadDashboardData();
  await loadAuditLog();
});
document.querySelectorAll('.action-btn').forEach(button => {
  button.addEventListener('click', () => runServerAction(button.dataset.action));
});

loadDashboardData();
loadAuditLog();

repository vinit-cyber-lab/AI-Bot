body {
  margin: 0;
  background: #0f172a;
  color: #e2e8f0;
  font-family: Arial, sans-serif;
}

.shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 220px;
  background: #111827;
  padding: 20px;
  border-right: 1px solid #1f2937;
}

.sidebar h1 {
  margin-top: 0;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sidebar nav a {
  color: #cbd5e1;
  text-decoration: none;
  padding: 10px 12px;
  border-radius: 8px;
}

.sidebar nav a.active,
.sidebar nav a:hover {
  background: #1d4ed8;
}

.content {
  flex: 1;
  padding: 24px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.cards-grid,
.panel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.card,
.panel {
  background: #111827;
  border: 1px solid #334155;
  border-radius: 12px;
  padding: 18px;
  box-shadow: 0 4px 14px rgba(0,0,0,0.15);
}

label {
  display: block;
  margin-top: 10px;
  color: #cbd5e1;
}

input, select, textarea, button {
  width: 100%;
  margin-top: 8px;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid #475569;
  background: #0f172a;
  color: #e2e8f0;
}

button {
  background: #2563eb;
  color: white;
  cursor: pointer;
  border: none;
  font-weight: 600;
}

button:hover {
  background: #1d4ed8;
}

.toggle-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin: 12px 0;
}

#audit-log {
  max-height: 260px;
  overflow: auto;
  font-size: 12px;
  line-height: 1.6;
}

.action-btn {
  margin: 8px 0;
}
